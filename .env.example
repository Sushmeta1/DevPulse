# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Public URL of the app (used to build the OAuth callback URL).
BASE_URL=http://localhost:4000
# Where the browser lives. Vite dev server = http://localhost:5173, Docker/Railway = same as BASE_URL.
FRONTEND_URL=http://localhost:5173

# --- PostgreSQL -------------------------------------------------------------
DATABASE_URL=postgresql://devpulse:devpulse@localhost:5432/devpulse
# Set to true for managed databases that require TLS.
DATABASE_SSL=false

# --- GitHub OAuth (https://github.com/settings/developers -> New OAuth App) ---
# Authorization callback URL must be: <BASE_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Secrets (generate with: openssl rand -hex 32) ---------------------------
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# --- AI (optional). Without a key, a rule-based summary is generated. ---------
# AI_PROVIDER=gemini | openai
AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Reports per user per 24h from a paid provider (0 = unlimited). Rule-based summaries are always free.
AI_DAILY_LIMIT=20

# --- Demo workspace (generated sample data; set false to hide the button) ----
DEMO_ENABLED=true

# Multiplies every rate-limit ceiling (leave unset in production; used by the e2e suite).
# RATE_LIMIT_SCALE=1

# --- Serverless (Vercel) --------------------------------------------------------
# BASE_URL is derived from Vercel's production domain; set it only for a custom domain.
# DB_POOL_MAX=3          # connections per serverless instance (default 3 on Vercel, 10 elsewhere)
# MIGRATE_ON_START=false # skip the migration check on cold start once the schema is current

# --- Weekly digest (optional) ---------------------------------------------------
# Slack needs nothing here: each user pastes their own incoming-webhook URL.
# E-mail uses Resend (https://resend.com, free tier is plenty). Both must be set to enable the e-mail channel.
# RESEND_API_KEY=
# DIGEST_FROM=DevPulse <digest@your-verified-domain>
# Scheduling: long-running servers send digests themselves (once a day at DIGEST_HOUR_UTC, default 7; DIGEST_SCHEDULER=off to disable).
# Serverless hosts use the cron endpoint instead: set CRON_SECRET and Vercel Cron (vercel.json) calls /api/cron/digest with it.
# CRON_SECRET=
# DIGEST_HOUR_UTC=7
